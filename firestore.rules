rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if requester is admin
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isHackathonTeamMember(hackathonId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/hackathons/$(hackathonId)) &&
        request.auth.uid in get(/databases/$(database)/documents/hackathons/$(hackathonId)).data.teamMembers;
    }

    function isJoiningHackathon() {
      return request.auth != null &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['teamMembers']) &&
        resource.data.status == 'open' &&
        !(request.auth.uid in resource.data.teamMembers) &&
        request.auth.uid in request.resource.data.teamMembers &&
        request.resource.data.teamMembers.hasAll(resource.data.teamMembers) &&
        request.resource.data.teamMembers.size() == resource.data.teamMembers.size() + 1;
    }

    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if request.auth != null && isAdmin();
    }

    // ── Hackathons ─────────────────────────────────────────────────────────
    match /hackathons/{hackathonId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.creatorId == request.auth.uid ||
        request.auth.uid in resource.data.teamMembers ||
        isJoiningHackathon() ||
        isAdmin()
      );
      allow delete: if request.auth != null && (
        resource.data.creatorId == request.auth.uid || isAdmin()
      );
    }

    // ── Upcoming Hackathons ────────────────────────────────────────────────
    match /upcomingHackathons/{hackathonId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.creatorId == request.auth.uid || isAdmin()
      );
      allow delete: if request.auth != null && (
        resource.data.creatorId == request.auth.uid || isAdmin()
      );
    }

    // ── Direct Messages ────────────────────────────────────────────────────
    match /directMessages/{messageId} {
      allow read: if request.auth != null && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
      allow create: if request.auth != null && request.auth.uid == request.resource.data.senderId;
      allow update: if request.auth != null && (
        resource.data.senderId == request.auth.uid ||
        (
          resource.data.recipientId == request.auth.uid &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['read', 'readAt'])
        )
      );
      allow delete: if request.auth != null && (
        resource.data.senderId == request.auth.uid || isAdmin()
      );
    }

    // ── Announcements ──────────────────────────────────────────────────────
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.authorId == request.auth.uid || isAdmin()
      );
      allow delete: if request.auth != null && (
        resource.data.authorId == request.auth.uid || isAdmin()
      );
    }

    // ── Notifications ──────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ── Team Chat ──────────────────────────────────────────────────────────
    match /teamChat/{messageId} {
      allow read: if request.auth != null && (
        isHackathonTeamMember(resource.data.hackathonId) || isAdmin()
      );
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.authorId &&
        isHackathonTeamMember(request.resource.data.hackathonId);
      allow update: if request.auth != null &&
        resource.data.authorId == request.auth.uid &&
        isHackathonTeamMember(resource.data.hackathonId);
      allow delete: if request.auth != null && (
        resource.data.authorId == request.auth.uid || isAdmin()
      );
    }

    // ── Hackathon Chat ─────────────────────────────────────────────────────
    match /hackathonChat/{messageId} {
      allow read: if request.auth != null && (
        isHackathonTeamMember(resource.data.hackathonId) || isAdmin()
      );
      allow create: if request.auth != null && (
        isHackathonTeamMember(request.resource.data.hackathonId) || isAdmin()
      );
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid &&
        isHackathonTeamMember(resource.data.hackathonId);
      allow delete: if request.auth != null && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // ── Team Feedbacks ─────────────────────────────────────────────────────
    match /teamFeedbacks/{feedbackId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.reviewerId;
      allow update: if request.auth != null && resource.data.reviewerId == request.auth.uid;
      allow delete: if false;
    }

    // ── Off-Platform Teams ─────────────────────────────────────────────────
    match /offPlatformTeams/{teamId} {
      allow read: if request.auth != null && (
        resource.data.leaderId == request.auth.uid ||
        request.auth.uid in resource.data.memberIds
      );
      allow create: if request.auth != null && request.auth.uid == request.resource.data.leaderId;
      allow update: if request.auth != null && resource.data.leaderId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.leaderId == request.auth.uid;
    }

    // ── Read Announcements ─────────────────────────────────────────────────
    match /readAnnouncements/{docId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ── Reports ────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow read: if request.auth != null && (
        resource.data.reporterId == request.auth.uid || isAdmin()
      );
      allow create: if request.auth != null;
      allow update: if isAdmin();
      allow delete: if false;
    }

  }
}
